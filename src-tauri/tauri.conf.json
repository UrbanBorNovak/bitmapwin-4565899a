{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitmapWIN",
  "version": "0.1.0",
  "identifier": "app.bitmapwin.desktop",
  "build": {
    "frontendDist": "https://bitmapwin.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BitmapWIN — Bitcoin-native worlds",
        "url": "https://bitmapwin.app",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#070b11"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
